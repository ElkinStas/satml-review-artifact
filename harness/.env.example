# Copy to .env and fill in.  .env is git-ignored — never commit a real key.
#
# ---------------------------------------------------------------------------
# Model provider.  Set the key for whichever policy you intend to run:
#   --policy claude  -> ANTHROPIC_API_KEY
#   --policy openai  -> OPENAI_API_KEY   (also serves any OpenAI-compatible endpoint)
# You only need the key for the policy you are actually using.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# The model that drives the agent. Required for both policies; there is no
# --model flag, the model is read from here.
#   Claude arm  (measurements in results/):  claude-opus-4-5
#   OpenAI arm  (cross-model check):         gpt-5.2
# ---------------------------------------------------------------------------
PILOT_MODEL=claude-opus-4-5

# ---------------------------------------------------------------------------
# Immutable id of the Docker image the run executes in. Written by
# `python -m agent.pin_environment --regenerate` inside the container; the
# preflight gate refuses to start if it does not match the running image.
# ---------------------------------------------------------------------------
RERAG_IMAGE_DIGEST=
